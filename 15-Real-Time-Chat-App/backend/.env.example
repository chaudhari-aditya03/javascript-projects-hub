# Environment Configuration for Backend

# Database
# For SQLite (default): sqlite:///./chat_app.db
# For PostgreSQL: postgresql://user:password@localhost/chat_db
# For MySQL: mysql+pymysql://user:password@localhost/chat_db
DATABASE_URL=sqlite:///./chat_app.db

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-use-strong-random-key

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Server
HOST=0.0.0.0
PORT=8000
